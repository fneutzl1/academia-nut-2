{
  "name": "@academia-nut/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public read-only API serving pulled datasets",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
