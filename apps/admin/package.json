{
  "name": "@academia-nut/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Admin server: runs data pulls and serves the admin UI",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "pull": "node dist/cli.js",
    "pull:dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@academia-nut/core": "workspace:*",
    "@academia-nut/pipeline": "workspace:*",
    "@academia-nut/shared": "workspace:*",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1"
  }
}
