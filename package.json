{
  "name": "academia-nut",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @academia-nut/api dev",
    "dev:admin": "pnpm --parallel --filter @academia-nut/admin --filter @academia-nut/admin-web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "start": "pnpm --filter \"@academia-nut/${APP_NAME:-api}\" start",
    "release": "if [ -n \"$DATABASE_URL\" ]; then pnpm --filter @academia-nut/db migrate:deploy; fi",
    "db:migrate": "pnpm --filter @academia-nut/db migrate",
    "db:studio": "pnpm --filter @academia-nut/db studio"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
