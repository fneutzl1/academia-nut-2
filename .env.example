# Copy to .env at the repo root. Both Express apps load it in local dev.
# On Heroku, set these as config vars instead.
NODE_ENV=development

# Which app `pnpm start` / Procfile launches on a Heroku dyno: api | admin
APP_NAME=api

# Where datasets are stored locally. Defaults to <repo>/data
# DATA_DIR=

# --- api app ---
API_PORT=4000
# Comma-separated list of origins allowed to call the public API
CORS_ORIGINS=http://localhost:5173

# --- admin app ---
ADMIN_PORT=4001
# Shared secret the admin UI sends as a Bearer token (placeholder until real auth)
ADMIN_TOKEN=change-me

# --- vendor credentials ---
CURRIC_USER=
CURRIC_PASS=
# Use the vendor's dev host while testing; prod is mws.services.curriqunet.com
CURRIC_HOST=mwsdev.services.curriqunet.com
AIRTABLE_TOKEN=
